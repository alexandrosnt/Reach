# Discord server scaffolding — see scripts/discord/README.md
# Copy to .env and fill in. .env is gitignored; this file must stay empty of secrets.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# GitHub webhook management — see scripts/discord/README.md
GITHUB_TOKEN=

# A machine to test the RDP panel against. Real values go in .env only.
RDP_TEST_HOST=
RDP_TEST_PORT=3389
RDP_TEST_USER=
RDP_TEST_PASS=
RDP_TEST_DOMAIN=
