<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "reach-app" (project Reach).
  Signs the program itself, before the installers are built around it.
  The GitHub artifact is a ZIP holding two copies of reach.exe, one marked for
  the MSI and one for the NSIS installer (see windows-signing.yml for why).
  A copy is kept here so it can be reviewed; SignPath uses the one saved in
  the project, so change both together.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="msi/reach.exe" product-name="Reach" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="nsis/reach.exe" product-name="Reach" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
